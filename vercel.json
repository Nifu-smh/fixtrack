{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "node",
      "entrypoint": "server.mjs",
      "bindings": [
        {
          "type": "service",
          "service": "fixtrack_source",
          "format": "url",
          "env": "FIXTRACK_SOURCE_URL"
        }
      ]
    },
    "fixtrack_source": {
      "root": "FixTrack_Source",
      "runtime": "node",
      "entrypoint": "server.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
